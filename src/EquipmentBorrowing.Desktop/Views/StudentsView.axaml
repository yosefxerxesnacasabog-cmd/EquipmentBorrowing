<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <TextBlock Classes="heading" Text="Students" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="235" PlaceholderText="Find by name or number" Text="{Binding Search}" />
            <Button Content="Refresh / retry" Command="{Binding LoadStudentsCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="New student" Command="{Binding NewStudentCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding LoadStatus}" TextWrapping="Wrap" />
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="14">
            <ListBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" IsEnabled="{Binding !IsBusy}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Student">
                        <StackPanel Spacing="4" Margin="0,5">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding StudentNumber}" />
                            <TextBlock Text="{Binding IsAllowedToBorrow, StringFormat='Eligible: {0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="8" IsEnabled="{Binding IsLoaded}">
                    <TextBlock Text="Student number" />
                    <TextBox Text="{Binding StudentNumber}" />
                    <TextBlock Text="Full name" />
                    <TextBox Text="{Binding FullName}" />
                    <TextBlock Text="Contact (optional)" />
                    <TextBox Text="{Binding Contact}" />
                    <Button Content="Save student" Command="{Binding SaveStudentCommand}" />
                    <WrapPanel>
                        <Button Content="Permit borrowing" Command="{Binding PermitCommand}" Margin="0,0,8,6" />
                        <Button Content="Restrict borrowing" Command="{Binding RestrictCommand}" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="4" Classes="message" Text="{Binding Message}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
