<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <TextBlock Classes="heading" Text="Equipment catalog" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="All equipment" Command="{Binding ShowAllCommand}" />
            <Button Content="Available only" Command="{Binding ShowAvailableCommand}" />
            <Button Content="Refresh / retry" Command="{Binding LoadEquipmentCommand}" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding LoadStatus}" TextWrapping="Wrap" />
        <ListBox Grid.Row="3" ItemsSource="{Binding Equipment}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Equipment">
                    <StackPanel Spacing="4" Margin="0,5">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Identifier, StringFormat='Equipment ID: {0}'}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
