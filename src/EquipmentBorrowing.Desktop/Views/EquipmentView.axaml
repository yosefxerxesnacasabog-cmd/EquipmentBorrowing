<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
    x:DataType="vm:EquipmentViewModel">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock
           Classes="heading"
           Text="Equipment"/>

        <ListBox ItemsSource="{Binding Equipment}">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Equipment">

                    <Border
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,5">

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="{Binding Name}"
                                FontSize="18"
                                FontWeight="Bold" />

                            <TextBlock
                                Text="{Binding Id, StringFormat='Equipment ID: {0}'}" />

                            <TextBlock
                                Text="{Binding IsAvailable, StringFormat='Available: {0}'}" />

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </StackPanel>

</UserControl>