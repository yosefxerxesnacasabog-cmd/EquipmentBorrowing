<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowEquipmentView"
             x:DataType="vm:BorrowEquipmentViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
            <TextBlock Classes="heading" Text="Borrow equipment" />
            <TextBlock Text="{Binding LoadStatus}" TextWrapping="Wrap" />
            <Button Content="Refresh / retry" Command="{Binding LoadDataCommand}" />
            <TextBlock Classes="label" Text="Student" />
            <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Student">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding StudentNumber}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="label" Text="Available equipment" />
            <ComboBox ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipment}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Equipment">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Identifier}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="label" Text="Expected return date" />
            <DatePicker SelectedDate="{Binding ExpectedReturnDate}" />
            <Button Content="Borrow equipment" Command="{Binding BorrowEquipmentCommand}" />
            <TextBlock Classes="message" Text="{Binding Message}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
