<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.Views.BorrowEquipmentView"
    x:DataType="vm:BorrowEquipmentViewModel">

    <StackPanel Margin="20" Spacing="15">

        <TextBlock
            Classes="heading"
            Text="Borrow Equipment"/>


        <TextBlock 
            Classes="label"
            Text="Select Student"/>

        <ComboBox
            ItemsSource="{Binding Students}"
            SelectedItem="{Binding SelectedStudent}"
            HorizontalAlignment="Stretch">

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>

        </ComboBox>

        <TextBlock 
            Classes="heading"
            Text="Select Equipment"/>

        <ComboBox
            ItemsSource="{Binding Equipment}"
            SelectedItem="{Binding SelectedEquipment}"
            HorizontalAlignment="Stretch">

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>

        </ComboBox>

        <TextBlock 
            Classes="label"
            Text="Expected Return Date"/>

        <DatePicker
            SelectedDate="{Binding ExpectedReturnDate}" />

       <Button

        Content="Borrow Equipment"
        Command="{Binding BorrowEquipmentCommand}"
        HorizontalAlignment="Left"
        Padding="15,8" />

        <TextBlock
            Classes="message"
            Text="{Binding Message}"/>

    </StackPanel>

</UserControl>