<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
    x:DataType="vm:BorrowingsViewModel">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock
            Text="Active Borrowings"
            FontSize="28"
            FontWeight="Bold" />

        <ListBox
            ItemsSource="{Binding Borrowings}"
            SelectedItem="{Binding SelectedBorrowing}">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Borrowing">

                    <Border
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,5">

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="{Binding Equipment.Name}"
                                FontSize="18"
                                FontWeight="Bold" />

                            <TextBlock
                                Text="{Binding Equipment.Id, StringFormat='Equipment ID: {0}'}" />

                            <TextBlock
                                Text="{Binding Student.Name, StringFormat='Borrowed by: {0}'}" />

                            <TextBlock
                                Text="{Binding DateBorrowed, StringFormat='Date Borrowed: {0:yyyy-MM-dd}'}" />

                            <TextBlock
                                Text="{Binding ExpectedReturnDate, StringFormat='Expected Return: {0:yyyy-MM-dd}'}" />

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <Button
            Content="Return Selected Equipment"
            Command="{Binding ReturnEquipmentCommand}"
            HorizontalAlignment="Left"
            Padding="15,8" />
        <TextBlock
        Text="{Binding Message}"
        TextWrapping="Wrap" />


    </StackPanel>

</UserControl>